# Phase 106 — DSPy offline tuning harness (dev-time only).
# The raw DSPy program.save() dump must NEVER be committed; adopted text
# re-enters only via a human-reviewed SKILL.md/refgen commit passing
# `helix-refgen --check`. (.venv/__pycache__/*.py[cod]/.pytest_cache are already
# ignored recursively above — only the optimizer output dir needs a new entry.)
/tools/dspy-tune/output/
# Materialized Aider reward corpus (CORPUS-01): machine-local descriptors that
# point at the clone cache + a provenance manifest — regenerated via
# `uv run python build_corpus.py`, never committed (the pristine fixtures live in
# the pinned upstream clone; licensing in bench/datasets/aider-polyglot/LICENSE-AUDIT.md).
/tools/dspy-tune/corpus/

zz-misc/
vue-implementation/

# Go
/helix
/helix-bench
/helix-bench-rag
/helix-eval
/serena
*.exe
/bin/
/api/proto/**/*.pb.go
test/bench/baselines/local.txt

# Bench runtime store artifacts left when a store-on cell test runs with
# cwd=bench/runtime (cwd-relative .helix/semantic.duckdb); generated, never tracked.
/bench/runtime/.helix/

# CLI E2E oracle (90-04) cold-start daemon writes a cwd-relative .helix/ store
# because TestCLI_ParallelColdSingleDaemon's daemon inherits the test package
# cwd; generated runtime artifact, never tracked.
/internal/cli/.helix/

# Contract golden oracle (92-03) drives a real helix subprocess; the activated
# daemon writes a cwd-relative .helix/semantic.duckdb under the test package dir.
# Generated runtime artifact, never tracked.
/test/oracle/contract/.helix/

# v2.4 dev-time tuning runs (run_real.py / optimize.py / smoke) drive a real
# helix daemon from cwd=tools/dspy-tune, which writes a cwd-relative
# .helix/semantic.duckdb store. Generated runtime artifact, never tracked.
/tools/dspy-tune/.helix/

# Eval harness runtime artifacts
/eval/reports/
/cmd/helix-eval/eval/

# Bench stack runtime reports (generated per-run; keep the tracked .gitkeep)
/bench/reports/*
!/bench/reports/.gitkeep
# Phase 100 BASELINE-01: force-track the committed, byte-reproducible polyglot-edit
# baseline under the otherwise-ignored bench/reports/* (mirrors the .gitkeep allowlist).
!/bench/reports/aider-edit-baseline/
!/bench/reports/aider-edit-baseline/**
# Phase 102 BASELINE-02: force-track the committed, byte-reproducible RepoMap-eval and
# fuzzy-robustness baselines under the otherwise-ignored bench/reports/* (mirror line 275).
!/bench/reports/repomap-eval-baseline/
!/bench/reports/repomap-eval-baseline/**
!/bench/reports/fuzzy-robust-baseline/
!/bench/reports/fuzzy-robust-baseline/**
