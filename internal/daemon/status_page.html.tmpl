<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Serena — In-Binary Metrics</title>
<style>
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif; margin: 1.5rem; color: #222; background: #fafafa; }
  h1 { font-size: 1.4rem; margin-bottom: 0.2rem; }
  h2 { font-size: 1.05rem; margin-top: 1.6rem; margin-bottom: 0.4rem; border-bottom: 1px solid #ddd; padding-bottom: 0.2rem; }
  table { border-collapse: collapse; width: 100%; max-width: 900px; margin-top: 0.3rem; background: #fff; }
  th, td { border: 1px solid #e0e0e0; padding: 0.3rem 0.6rem; text-align: left; font-size: 0.92rem; }
  th { background: #f0f0f0; font-weight: 600; }
  tr:nth-child(even) td { background: #fbfbfb; }
  .empty { color: #888; font-style: italic; }
  .annotation { color: #777; font-size: 0.78rem; font-weight: 400; }
  .footer { margin-top: 2rem; color: #888; font-size: 0.78rem; }
  .state-closed { color: #2a7a2a; }
  .state-half-open { color: #c08000; }
  .state-open { color: #b03030; font-weight: 600; }
  code { font-family: "SF Mono", Menlo, Consolas, monospace; font-size: 0.88rem; }
</style>
</head>
<body>
<h1>Serena — In-Binary Metrics</h1>
<p class="annotation">Live snapshot from the same registry that serves <code>/metrics</code>. Refresh to re-render.</p>

<h2>Tool RED <span class="annotation">(counts + p95 latency)</span></h2>
{{if .Tools}}
<table>
  <thead><tr><th>Tool</th><th>Calls</th><th>p95 seconds <span class="annotation">(approx, bucket-quantized)</span></th></tr></thead>
  <tbody>
  {{range .Tools}}
    <tr><td>{{.Name}}</td><td>{{.Calls}}</td><td>{{if .HasP95}}{{printf "%.4f" .P95Seconds}}{{else}}—{{end}}</td></tr>
  {{end}}
  </tbody>
</table>
{{else}}<p class="empty">No tool calls observed yet.</p>{{end}}

<h2>Edit Outcomes</h2>
{{if .Edits}}
<table>
  <thead><tr><th>Tool</th><th>Outcome</th><th>Count</th></tr></thead>
  <tbody>
  {{range .Edits}}
    <tr><td>{{.Tool}}</td><td>{{.Outcome}}</td><td>{{.Count}}</td></tr>
  {{end}}
  </tbody>
</table>
{{else}}<p class="empty">No edit outcomes observed yet.</p>{{end}}

<h2>LSP Pool Workers</h2>
{{if .Workers}}
<table>
  <thead><tr><th>Language</th><th>Workers</th></tr></thead>
  <tbody>
  {{range .Workers}}
    <tr><td>{{.Language}}</td><td>{{.Count}}</td></tr>
  {{end}}
  </tbody>
</table>
{{else}}<p class="empty">No active workers.</p>{{end}}

<h2>Circuit State by Language</h2>
{{if .Circuits}}
<table>
  <thead><tr><th>Language</th><th>State</th></tr></thead>
  <tbody>
  {{range .Circuits}}
    <tr><td>{{.Language}}</td><td class="state-{{.State}}">{{.State}}</td></tr>
  {{end}}
  </tbody>
</table>
{{else}}<p class="empty">No circuits observed.</p>{{end}}

<h2>Recent Eviction Reasons <span class="annotation">(non-zero counters since process start)</span></h2>
{{if .Evictions}}
<table>
  <thead><tr><th>Language</th><th>Reason</th><th>Count</th></tr></thead>
  <tbody>
  {{range .Evictions}}
    <tr><td>{{.Language}}</td><td>{{.Reason}}</td><td>{{.Count}}</td></tr>
  {{end}}
  </tbody>
</table>
{{else}}<p class="empty">No evictions since process start.</p>{{end}}

<h2>Cache Hit Rate</h2>
{{if .Caches}}
<table>
  <thead><tr><th>Family</th><th>Language</th><th>Hit Rate</th></tr></thead>
  <tbody>
  {{range .Caches}}
    <tr><td>{{.Family}}</td><td>{{.Language}}</td><td>{{if .HasData}}{{printf "%.1f%%" .HitRatePct}}{{else}}—{{end}}</td></tr>
  {{end}}
  </tbody>
</table>
{{else}}<p class="empty">No cache activity observed.</p>{{end}}

<h2>Process</h2>
<table>
  <tbody>
    <tr><td>RSS</td><td>{{if .Process.HasRSS}}{{.Process.RSSHuman}}{{else}}—{{end}}</td></tr>
    <tr><td>Goroutines</td><td>{{.Process.Goroutines}}</td></tr>
  </tbody>
</table>

<p class="footer">Generated at {{.GeneratedAt.Format "2006-01-02T15:04:05Z07:00"}}</p>
</body>
</html>
