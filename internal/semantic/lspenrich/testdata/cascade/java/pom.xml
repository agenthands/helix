<?xml version="1.0" encoding="UTF-8"?>
<!--
  Phase 61 P02 cascade integration-test fixture.

  Minimal Maven project layout so jdtls picks up the source set under
  src/main/java without any external dependencies. Two classes (A, B) with
  a call from A.method() to B.method() exercise the §14.4 cascade end-to-
  end (documentSymbol → callHierarchy → definition).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.example</groupId>
  <artifactId>cascade-fixture</artifactId>
  <version>0.0.1</version>
  <packaging>jar</packaging>
  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
</project>
